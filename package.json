{
  "name": "@local/dsh-guided-image-generation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH Web plugin: a draggable prompt-guided image generation panel with pluggable OpenAI-compatible providers.",
  "keywords": ["dsh", "dsh-plugin", "image-generation", "openai-compatible"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huanym/dsh-guided-image-generation.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "server/*.py",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
